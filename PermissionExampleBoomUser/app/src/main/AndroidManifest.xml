<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" >

    <!--  App needs the "...BOOM_PERM permission -->
    <uses-permission android:name="course.examples.permissionexample.BOOM_PERM" />

    <!-- Android 11+ package visibility: lets this app see the Boom app that defines BOOM_PERM -->
    <queries>
        <package android:name="course.examples.permissionexample.boom" />
    </queries>

    <application
        android:allowBackup="true"
        android:theme="@style/MaterialTheme"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name" >
        <activity
            android:name="course.examples.permissionexample.boomuser.BoomUserActivity"
            android:exported="true"
            android:label="@string/app_name" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
